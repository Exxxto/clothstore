{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "outDir": "dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.d.ts", "../src/lib/productCatalog.ts"],
  "exclude": ["node_modules", "dist"]
}
